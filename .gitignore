# Datasets are never committed: raw, processed, manual and generated data all live under data/.
# docs/data_sources.md and config/ describe how to rebuild them.
data/*
# Explicit M8 exception (D-048): the small demo export app/index.html reads is committed.
# Nothing else under data/ is ever committed.
!data/export/
data/export/*
!data/export/sitescout.json
!data/export/sitescout.js

# Python environment, build output and tool caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Environment files: SiteScout never reads them, and they must never be committed.
.env
.env.*

# Logs
*.log

# Local editor, agent and OS files
.claude/settings.local.json
.vscode/
.idea/
desktop.ini
Thumbs.db
.DS_Store
